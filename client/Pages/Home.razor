@page "/"
@using Delivery.Contracts
@using Delivery.Client.Services
@inject OrderApi Api

<PageTitle>Leveringsplanlægger</PageTitle>

<section class="hero">
    <div class="hero-text">
        <span class="eyebrow">Hvidevareforhandler med flere lagre</span>
        <h1>Leveringer på tværs af lagre</h1>
        <p>
            I dag koordineres leveringerne i delte To Do-lister. Leveringsplanlæggeren samler ordrerne ét sted,
            og reglerne for hvem der må flytte en ordre håndhæves på serveren, så de ikke kan omgås.
        </p>
    </div>
    <ul class="problems">
        <li>
            <span class="problem-icon" aria-hidden="true">1</span>
            <div><strong>Ingen historik</strong><span>En mislykket levering oprettes bare igen, og forsøget forsvinder.</span></div>
        </li>
        <li>
            <span class="problem-icon" aria-hidden="true">2</span>
            <div><strong>Intet ejerskab</strong><span>Ingen kan se, hvem der flyttede en ordre og hvornår.</span></div>
        </li>
        <li>
            <span class="problem-icon" aria-hidden="true">3</span>
            <div><strong>Intet overblik</strong><span>En forsinkelse opdages først, når kunden ringer.</span></div>
        </li>
    </ul>
</section>

<details class="howto">
    <summary>Hvad proof of concept viser</summary>
    <ol>
        <li>Listen hentes gennem hele kæden: browser, REST til ASP.NET Core, gRPC til Spring Boot og PostgreSQL.</li>
        <li>Knapperne viser kun de overgange, Javas statusmaskine tillader fra ordrens nuværende status.</li>
        <li>Hver ændring sender ordrens version med. Har en anden planlægger ændret ordren imens, afviser serveren skrivningen, så to planlæggere ikke overskriver hinanden.</li>
        <li>En ulovlig overgang afvises af Java, også hvis brugerfladen omgås.</li>
    </ol>
</details>

@if (selected is null)
{
    @NoticeView
}

@if (orders is null)
{
    <p class="muted loading">Henter leveringer...</p>
}
else if (orders.Count == 0)
{
    <div class="empty">
        <strong>Ingen leveringer</strong>
        <span>Der er ingen ordrer i databasen. Start domæneserveren igen for at lægge demodata ind.</span>
    </div>
}
else
{
    <nav class="tiles" aria-label="Filtrér efter status">
        <button class="tile @(filter is null ? "active" : "")" @onclick="() => filter = null">
            <span class="tile-count">@orders.Count</span>
            <span class="tile-label">Alle</span>
        </button>
        @foreach (var status in AllStatuses)
        {
            var count = orders.Count(o => o.Status == status);
            <button class="tile tile-@status.ToLowerInvariant() @(filter == status ? "active" : "") @(count == 0 ? "zero" : "")"
                    @onclick="() => filter = filter == status ? null : status">
                <span class="tile-count">@count</span>
                <span class="tile-label"><span class="dot"></span>@Label(status)</span>
            </button>
        }
    </nav>

    <div class="layout @(selected is not null ? "has-selection" : "")">
        <section class="card list">
            <div class="card-head">
                <h2>Leveringer</h2>
                <span class="muted small">@Visible.Count af @orders.Count ordrer</span>
            </div>

            @if (Visible.Count == 0)
            {
                <p class="muted list-empty">Ingen ordrer med status @Label(filter!).</p>
            }

            <ul class="rows">
                @foreach (var order in Visible)
                {
                    <li class="row @(order.Id == selected?.Id ? "selected" : "")" @onclick="() => Select(order)">
                        <span class="avatar avatar-@order.Status.ToLowerInvariant()" aria-hidden="true">@(order.Product[..1])</span>
                        <div class="row-main">
                            <div class="row-title">
                                <span class="strong">@order.Customer</span>
                                <span class="status status-@order.Status.ToLowerInvariant()">@Label(order.Status)</span>
                            </div>
                            <div class="row-meta">
                                <span>@order.Product</span>
                                <span class="sep">·</span>
                                <span>@Warehouse(order.WarehouseId)</span>
                            </div>
                            <div class="row-time">@FormatWindow(order)</div>
                        </div>
                        <span class="version" title="Version">v@(order.Version)</span>
                        <button class="btn btn-ghost" @onclick="() => Select(order)" @onclick:stopPropagation>Åbn</button>
                    </li>
                }
            </ul>
        </section>

        @if (selected is not null)
        {
            <div class="sheet-backdrop" @onclick="Close"></div>
            <aside class="card detail">
                <div class="detail-head">
                    <div>
                        <span class="eyebrow">Levering</span>
                        <h2>@selected.Customer</h2>
                    </div>
                    <button class="btn btn-ghost" @onclick="Close">Luk</button>
                </div>

                @NoticeView

                <div class="detail-status">
                    <span class="status status-lg status-@selected.Status.ToLowerInvariant()">@Label(selected.Status)</span>
                    <span class="version" title="Version">Version @selected.Version</span>
                </div>

                <ol class="steps">
                    @foreach (var step in Flow)
                    {
                        <li class="step @StepClass(step)"><span class="step-dot"></span>@Label(step)</li>
                    }
                </ol>
                @if (selected.Status is "FAILED" or "CANCELLED")
                {
                    <p class="muted small off-flow">Ordren er @(Label(selected.Status).ToLowerInvariant()) og står uden for den normale rute.</p>
                }

                <dl class="facts">
                    <div><dt>Vare</dt><dd>@selected.Product</dd></div>
                    <div><dt>Lager</dt><dd>@Warehouse(selected.WarehouseId)</dd></div>
                    <div><dt>Vindue</dt><dd>@FormatWindow(selected)</dd></div>
                </dl>

                <h3>Næste skridt</h3>
                <p class="muted small">Overgangene kommer fra statusmaskinen i Java.</p>
                @if (allowed.Count == 0)
                {
                    <p class="muted">Ingen. Ordren er i en sluttilstand.</p>
                }
                else
                {
                    <div class="actions">
                        @foreach (var status in allowed)
                        {
                            <button class="btn btn-move btn-@status.ToLowerInvariant()" @onclick="() => Move(status)">@Label(status)</button>
                        }
                    </div>
                }

                <div class="bypass">
                    <h3>Test reglerne</h3>
                    <p class="muted small">Send en vilkårlig status direkte til serveren, uden om knapperne. Java afviser den, hvis statusmaskinen ikke tillader den.</p>
                    <div class="bypass-row">
                        <select @bind="manualStatus" aria-label="Status der sendes">
                            @foreach (var status in AllStatuses)
                            {
                                <option value="@status">@Label(status)</option>
                            }
                        </select>
                        <button class="btn btn-dark" @onclick="() => Move(manualStatus)">Send</button>
                    </div>
                </div>
            </aside>
        }
    </div>
}

@code {
    private static readonly string[] AllStatuses =
        ["PENDING", "ASSIGNED", "PICKED_UP", "IN_TRANSIT", "DELIVERED", "FAILED", "CANCELLED"];

    private static readonly Dictionary<string, string> Labels = new()
    {
        ["PENDING"] = "Afventer",
        ["ASSIGNED"] = "Tildelt",
        ["PICKED_UP"] = "Afhentet",
        ["IN_TRANSIT"] = "Undervejs",
        ["DELIVERED"] = "Leveret",
        ["FAILED"] = "Mislykket",
        ["CANCELLED"] = "Annulleret",
    };

    // Kun til visning af tidslinjen. Hvilke skift der er lovlige, afgør Java.
    private static readonly string[] Flow =
        ["PENDING", "ASSIGNED", "PICKED_UP", "IN_TRANSIT", "DELIVERED"];

    private List<OrderDto>? orders;
    private string? filter;
    private OrderDto? selected;
    private List<string> allowed = [];
    private string manualStatus = "DELIVERED";
    private string? messageTitle;
    private string? message;
    private string? messageDetail;
    private bool messageIsError;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        orders = await Api.GetOrdersAsync();
        if (selected is not null)
        {
            selected = orders.FirstOrDefault(o => o.Id == selected.Id);
            allowed = selected is null ? [] : await Api.GetAllowedAsync(selected.Id);
        }
    }

    private async Task Select(OrderDto order)
    {
        selected = order;
        message = null;
        allowed = await Api.GetAllowedAsync(order.Id);
    }

    private void Close()
    {
        selected = null;
        allowed = [];
    }

    private async Task Move(string toStatus)
    {
        if (selected is null)
        {
            return;
        }
        try
        {
            // Versionen er den, knapperne blev tegnet på. Er ordren ændret
            // siden, afviser Java skrivningen.
            var updated = await Api.TransitionAsync(selected.Id, toStatus, selected.Version);
            messageTitle = "Status ændret";
            message = $"{updated.Customer}: {Label(selected.Status)} til {Label(updated.Status)}. Ny version {updated.Version}.";
            messageDetail = null;
            messageIsError = false;
        }
        catch (ApiException e)
        {
            (messageTitle, message) = e.StatusCode switch
            {
                409 => ("Ordren er ændret af en anden",
                        "Ordren er blevet ændret, siden du åbnede den. Din ændring er ikke gemt. Listen er hentet igen, så du ser den nyeste version."),
                422 => ("Overgangen er ikke tilladt",
                        $"Statusmaskinen tillader ikke {Label(toStatus)} fra {Label(selected.Status)}. Intet er gemt."),
                _ => ("Ændringen blev afvist", "Serveren afviste ændringen. Intet er gemt."),
            };
            messageDetail = $"Svar fra serveren ({e.StatusCode}): {e.Message}";
            messageIsError = true;
        }
        await Reload();
    }

    private RenderFragment NoticeView => __builder =>
    {
        if (message is not null)
        {
            <div class="notice @(messageIsError ? "notice-error" : "notice-ok")" role="status">
                <span class="notice-icon" aria-hidden="true">@(messageIsError ? "!" : "✓")</span>
                <div class="notice-content">
                    <div class="notice-title">@messageTitle</div>
                    <div class="notice-body">@message</div>
                    @if (messageDetail is not null)
                    {
                        <code class="notice-detail">@messageDetail</code>
                    }
                </div>
                <button class="notice-close" @onclick="() => message = null" aria-label="Luk besked">×</button>
            </div>
        }
    };

    private List<OrderDto> Visible =>
        orders is null ? [] : orders.Where(o => filter is null || o.Status == filter).ToList();

    private string StepClass(string step)
    {
        var current = Array.IndexOf(Flow, selected?.Status);
        var index = Array.IndexOf(Flow, step);
        if (current < 0) return "";
        return index < current ? "done" : index == current ? "current" : "";
    }

    private static string Warehouse(string id)
    {
        var name = id.StartsWith("lager-") ? id[6..] : id;
        return name.Length == 0 ? id : char.ToUpperInvariant(name[0]) + name[1..];
    }

    private static string Label(string status) =>
        Labels.TryGetValue(status, out var label) ? label : status;

    private static string FormatWindow(OrderDto order) =>
        DateTimeOffset.TryParse(order.DeliveryWindowStart, out var start)
        && DateTimeOffset.TryParse(order.DeliveryWindowEnd, out var end)
            ? $"{start.ToLocalTime():dd/MM HH:mm} til {end.ToLocalTime():HH:mm}"
            : "";
}

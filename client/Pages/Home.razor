@page "/"
@using Delivery.Contracts
@using Delivery.Client.Services
@inject OrderApi Api

<PageTitle>Leveringer</PageTitle>

<h1>Leveringer</h1>
<p class="hint">Proof of concept: browser → REST → ASP.NET Core → gRPC → Spring Boot → PostgreSQL</p>

@if (message is not null)
{
    <div class="message @(messageIsError ? "error" : "ok")">@message</div>
}

@if (orders is null)
{
    <p>Henter leveringer...</p>
}
else
{
    <div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Kunde</th>
                <th>Vare</th>
                <th>Lager</th>
                <th>Vindue</th>
                <th>Status</th>
                <th>Version</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in orders)
            {
                <tr class="@(order.Id == selected?.Id ? "selected" : "")">
                    <td>@order.Customer</td>
                    <td>@order.Product</td>
                    <td>@order.WarehouseId</td>
                    <td>@FormatWindow(order)</td>
                    <td><span class="status status-@order.Status.ToLowerInvariant()">@order.Status</span></td>
                    <td>@order.Version</td>
                    <td><button @onclick="() => Select(order)">Vælg</button></td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    @if (selected is not null)
    {
        <section class="panel">
            <h2>@selected.Customer · @selected.Product</h2>
            <p>Status <strong>@selected.Status</strong>, version @selected.Version</p>

            <h3>Tilladte overgange (fra Java)</h3>
            @if (allowed.Count == 0)
            {
                <p>Ingen. Ordren er i en sluttilstand.</p>
            }
            @foreach (var status in allowed)
            {
                <button class="primary" @onclick="() => Move(status)">→ @status</button>
            }

            <h3>Prøv en overgang uden om knapperne</h3>
            <p class="hint">Sender en vilkårlig status direkte. Java afviser den, hvis tabellen ikke tillader den.</p>
            <select @bind="manualStatus">
                @foreach (var status in AllStatuses)
                {
                    <option value="@status">@status</option>
                }
            </select>
            <button @onclick="() => Move(manualStatus)">Send</button>
        </section>
    }
}

@code {
    private static readonly string[] AllStatuses =
        ["PENDING", "ASSIGNED", "PICKED_UP", "IN_TRANSIT", "DELIVERED", "FAILED", "CANCELLED"];

    private List<OrderDto>? orders;
    private OrderDto? selected;
    private List<string> allowed = [];
    private string manualStatus = "DELIVERED";
    private string? message;
    private bool messageIsError;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        orders = await Api.GetOrdersAsync();
        if (selected is not null)
        {
            selected = orders.FirstOrDefault(o => o.Id == selected.Id);
            allowed = selected is null ? [] : await Api.GetAllowedAsync(selected.Id);
        }
    }

    private async Task Select(OrderDto order)
    {
        selected = order;
        message = null;
        allowed = await Api.GetAllowedAsync(order.Id);
    }

    private async Task Move(string toStatus)
    {
        if (selected is null)
        {
            return;
        }
        try
        {
            // Versionen er den, knapperne blev tegnet på. Er ordren ændret
            // siden, afviser Java skrivningen.
            var updated = await Api.TransitionAsync(selected.Id, toStatus, selected.Version);
            message = $"{updated.Customer}: {selected.Status} → {updated.Status} (version {updated.Version})";
            messageIsError = false;
        }
        catch (ApiException e)
        {
            message = $"Afvist ({e.StatusCode}): {e.Message}";
            messageIsError = true;
        }
        await Reload();
    }

    private static string FormatWindow(OrderDto order) =>
        DateTimeOffset.TryParse(order.DeliveryWindowStart, out var start)
        && DateTimeOffset.TryParse(order.DeliveryWindowEnd, out var end)
            ? $"{start.ToLocalTime():dd/MM HH:mm} til {end.ToLocalTime():HH:mm}"
            : "";
}

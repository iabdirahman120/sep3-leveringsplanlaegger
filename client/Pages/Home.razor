@page "/"
@using Delivery.Contracts
@using Delivery.Client.Services
@inject OrderApi Api

<PageTitle>Leveringsplanlægger</PageTitle>

<header class="page-head">
    <div>
        <p class="date">@Today</p>
        <h1>Leveringer</h1>
        @if (orders is not null)
        {
            <p class="sub">@orders.Count ordrer fordelt på @orders.Select(o => o.WarehouseId).Distinct().Count() lagre</p>
        }
    </div>
    @if (orders is not null && Warehouses.Count > 1)
    {
        <div class="segmented" role="group" aria-label="Vælg lager">
            <button class="@(warehouse is null ? "on" : "")" @onclick="() => warehouse = null">Alle lagre</button>
            @foreach (var w in Warehouses)
            {
                <button class="@(warehouse == w ? "on" : "")" @onclick="() => warehouse = w">@Warehouse(w)</button>
            }
        </div>
    }
</header>

<section class="why">
    <div class="why-intro">
        <span class="kicker">Hvorfor systemet findes</span>
        <p>
            En hvidevareforhandler leverer fra flere lagre med egne chauffører. I dag koordineres det i delte
            To Do-lister. Her samles ordrerne ét sted, og reglerne for hvem der må flytte en ordre håndhæves på serveren.
        </p>
    </div>
    <div class="why-problems">
        <div class="problem">
            <span class="problem-ico" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 2" /><circle cx="12" cy="12" r="9" /></svg>
            </span>
            <div><strong>Ingen historik</strong><span>Et mislykket forsøg forsvinder, når leveringen oprettes igen.</span></div>
        </div>
        <div class="problem">
            <span class="problem-ico" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" /></svg>
            </span>
            <div><strong>Intet ejerskab</strong><span>Ingen kan se, hvem der flyttede en ordre og hvornår.</span></div>
        </div>
        <div class="problem">
            <span class="problem-ico" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12s3.5-6 9-6 9 6 9 6-3.5 6-9 6-9-6-9-6z" /><circle cx="12" cy="12" r="2.5" /></svg>
            </span>
            <div><strong>Intet overblik</strong><span>En forsinkelse opdages først, når kunden ringer.</span></div>
        </div>
    </div>
    <details class="howto">
        <summary>Hvad proof of concept viser</summary>
        <ol>
            <li>Tavlen hentes gennem hele kæden: browser, REST til ASP.NET Core, gRPC til Spring Boot og PostgreSQL.</li>
            <li>Knapperne viser kun de overgange, Javas statusmaskine tillader fra ordrens nuværende status.</li>
            <li>Hver ændring sender ordrens version med. Har en anden planlægger ændret ordren imens, afviser serveren skrivningen.</li>
            <li>En ulovlig overgang afvises af Java, også hvis brugerfladen omgås.</li>
        </ol>
    </details>
</section>

@if (selected is null)
{
    @NoticeView
}

@if (orders is null)
{
    <div class="board">
        @for (var i = 0; i < 4; i++)
        {
            <div class="column"><div class="skeleton"></div><div class="skeleton"></div></div>
        }
    </div>
}
else if (orders.Count == 0)
{
    <div class="empty">
        <strong>Ingen leveringer</strong>
        <span>Der er ingen ordrer i databasen. Start domæneserveren igen for at lægge demodata ind.</span>
    </div>
}
else
{
    <div class="board">
        @foreach (var column in Columns)
        {
            var items = Visible.Where(o => column.Statuses.Contains(o.Status)).ToList();
            <section class="column col-@column.Key">
                <header class="column-head">
                    <span class="dot"></span>
                    <h2>@column.Title</h2>
                    <span class="count">@items.Count</span>
                </header>
                <ul class="cards">
                    @foreach (var order in items)
                    {
                        <li class="card @(order.Id == selected?.Id ? "selected" : "")" @onclick="() => Select(order)">
                            <div class="card-top">
                                <span class="customer">@order.Customer</span>
                                <span class="version" title="Version">v@(order.Version)</span>
                            </div>
                            <p class="product">@order.Product</p>
                            <div class="card-meta">
                                <span class="chip">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10l9-6 9 6v10H3z" /><path d="M9 20v-6h6v6" /></svg>
                                    @Warehouse(order.WarehouseId)
                                </span>
                                <span class="chip">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                                    @FormatWindow(order)
                                </span>
                            </div>
                            @if (column.Statuses.Length > 1)
                            {
                                <span class="status status-@order.Status.ToLowerInvariant()">@Label(order.Status)</span>
                            }
                            <button class="open" @onclick="() => Select(order)" @onclick:stopPropagation>Åbn</button>
                        </li>
                    }
                    @if (items.Count == 0)
                    {
                        <li class="none">Ingen</li>
                    }
                </ul>
            </section>
        }
    </div>
}

@if (selected is not null)
{
    <div class="backdrop" @onclick="Close"></div>
    <aside class="drawer" aria-label="Levering">
        <div class="drawer-head">
            <div>
                <span class="kicker">@selected.Product</span>
                <h2>@selected.Customer</h2>
            </div>
            <button class="icon-btn" @onclick="Close" aria-label="Luk">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
        </div>

        @NoticeView

        <div class="drawer-status">
            <span class="status status-lg status-@selected.Status.ToLowerInvariant()">@Label(selected.Status)</span>
            <span class="version">Version @selected.Version</span>
        </div>

        <ol class="steps">
            @foreach (var step in Flow)
            {
                <li class="step @StepClass(step)"><span class="step-dot"></span><span>@Label(step)</span></li>
            }
        </ol>
        @if (selected.Status is "FAILED" or "CANCELLED")
        {
            <p class="off-flow">Ordren er @(Label(selected.Status).ToLowerInvariant()) og står uden for den normale rute.</p>
        }

        <dl class="facts">
            <div><dt>Vare</dt><dd>@selected.Product</dd></div>
            <div><dt>Lager</dt><dd>@Warehouse(selected.WarehouseId)</dd></div>
            <div><dt>Vindue</dt><dd>@FormatWindow(selected)</dd></div>
        </dl>

        <h3>Næste skridt</h3>
        <p class="hint">Overgangene kommer fra statusmaskinen i Java.</p>
        @if (allowed.Count == 0)
        {
            <p class="hint">Ingen. Ordren er i en sluttilstand.</p>
        }
        else
        {
            <div class="actions">
                @foreach (var status in allowed)
                {
                    <button class="move move-@status.ToLowerInvariant()" @onclick="() => Move(status)">
                        <span class="dot"></span>@Label(status)
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                    </button>
                }
            </div>
        }

        <div class="bypass">
            <h3>Test reglerne</h3>
            <p class="hint">Send en vilkårlig status direkte til serveren, uden om knapperne. Java afviser den, hvis statusmaskinen ikke tillader den.</p>
            <div class="bypass-row">
                <select @bind="manualStatus" aria-label="Status der sendes">
                    @foreach (var status in AllStatuses)
                    {
                        <option value="@status">@Label(status)</option>
                    }
                </select>
                <button class="send" @onclick="() => Move(manualStatus)">Send</button>
            </div>
        </div>
    </aside>
}

@code {
    private static readonly string[] AllStatuses =
        ["PENDING", "ASSIGNED", "PICKED_UP", "IN_TRANSIT", "DELIVERED", "FAILED", "CANCELLED"];

    private static readonly Dictionary<string, string> Labels = new()
    {
        ["PENDING"] = "Afventer",
        ["ASSIGNED"] = "Tildelt",
        ["PICKED_UP"] = "Afhentet",
        ["IN_TRANSIT"] = "Undervejs",
        ["DELIVERED"] = "Leveret",
        ["FAILED"] = "Mislykket",
        ["CANCELLED"] = "Annulleret",
    };

    // Kun til visning af tavlen og tidslinjen. Hvilke skift der er lovlige, afgør Java.
    private static readonly string[] Flow =
        ["PENDING", "ASSIGNED", "PICKED_UP", "IN_TRANSIT", "DELIVERED"];

    private record Column(string Key, string Title, string[] Statuses);

    private static readonly Column[] Columns =
    [
        new("pending", "Afventer", ["PENDING"]),
        new("assigned", "Tildelt", ["ASSIGNED"]),
        new("picked_up", "Afhentet", ["PICKED_UP"]),
        new("in_transit", "Undervejs", ["IN_TRANSIT"]),
        new("delivered", "Leveret", ["DELIVERED"]),
        new("failed", "Afvigelser", ["FAILED", "CANCELLED"]),
    ];

    private static readonly string[] Days = ["Søndag", "Mandag", "Tirsdag", "Onsdag", "Torsdag", "Fredag", "Lørdag"];
    private static readonly string[] Months =
        ["januar", "februar", "marts", "april", "maj", "juni", "juli", "august", "september", "oktober", "november", "december"];

    private List<OrderDto>? orders;
    private string? warehouse;
    private OrderDto? selected;
    private List<string> allowed = [];
    private string manualStatus = "DELIVERED";
    private string? messageTitle;
    private string? message;
    private string? messageDetail;
    private bool messageIsError;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        orders = await Api.GetOrdersAsync();
        if (selected is not null)
        {
            selected = orders.FirstOrDefault(o => o.Id == selected.Id);
            allowed = selected is null ? [] : await Api.GetAllowedAsync(selected.Id);
        }
    }

    private async Task Select(OrderDto order)
    {
        selected = order;
        message = null;
        allowed = await Api.GetAllowedAsync(order.Id);
    }

    private void Close()
    {
        selected = null;
        allowed = [];
    }

    private async Task Move(string toStatus)
    {
        if (selected is null)
        {
            return;
        }
        try
        {
            // Versionen er den, knapperne blev tegnet på. Er ordren ændret
            // siden, afviser Java skrivningen.
            var updated = await Api.TransitionAsync(selected.Id, toStatus, selected.Version);
            messageTitle = "Status ændret";
            message = $"{updated.Customer}: {Label(selected.Status)} til {Label(updated.Status)}. Ny version {updated.Version}.";
            messageDetail = null;
            messageIsError = false;
        }
        catch (ApiException e)
        {
            (messageTitle, message) = e.StatusCode switch
            {
                409 => ("Ordren er ændret af en anden",
                        "Ordren er blevet ændret, siden du åbnede den. Din ændring er ikke gemt. Listen er hentet igen, så du ser den nyeste version."),
                422 => ("Overgangen er ikke tilladt",
                        $"Statusmaskinen tillader ikke {Label(toStatus)} fra {Label(selected.Status)}. Intet er gemt."),
                _ => ("Ændringen blev afvist", "Serveren afviste ændringen. Intet er gemt."),
            };
            messageDetail = $"Svar fra serveren ({e.StatusCode}): {e.Message}";
            messageIsError = true;
        }
        await Reload();
    }

    private RenderFragment NoticeView => __builder =>
    {
        if (message is not null)
        {
            <div class="notice @(messageIsError ? "notice-error" : "notice-ok")" role="status">
                <span class="notice-icon" aria-hidden="true">@(messageIsError ? "!" : "✓")</span>
                <div class="notice-content">
                    <div class="notice-title">@messageTitle</div>
                    <div class="notice-body">@message</div>
                    @if (messageDetail is not null)
                    {
                        <code class="notice-detail">@messageDetail</code>
                    }
                </div>
                <button class="notice-close" @onclick="() => message = null" aria-label="Luk besked">×</button>
            </div>
        }
    };

    private List<OrderDto> Visible =>
        orders is null ? [] : orders.Where(o => warehouse is null || o.WarehouseId == warehouse).ToList();

    private List<string> Warehouses =>
        orders is null ? [] : orders.Select(o => o.WarehouseId).Distinct().Order().ToList();

    private static string Today
    {
        get
        {
            var d = DateTime.Now;
            return $"{Days[(int)d.DayOfWeek]} {d.Day}. {Months[d.Month - 1]}";
        }
    }

    private string StepClass(string step)
    {
        var current = Array.IndexOf(Flow, selected?.Status);
        var index = Array.IndexOf(Flow, step);
        if (current < 0) return "";
        return index < current ? "done" : index == current ? "current" : "";
    }

    private static string Warehouse(string id)
    {
        var name = id.StartsWith("lager-") ? id[6..] : id;
        return name.Length == 0 ? id : char.ToUpperInvariant(name[0]) + name[1..];
    }

    private static string Label(string status) =>
        Labels.TryGetValue(status, out var label) ? label : status;

    private static string FormatWindow(OrderDto order) =>
        DateTimeOffset.TryParse(order.DeliveryWindowStart, out var start)
        && DateTimeOffset.TryParse(order.DeliveryWindowEnd, out var end)
            ? $"{start.ToLocalTime():dd/MM HH:mm}-{end.ToLocalTime():HH:mm}"
            : "";
}
